package main

import "time"

// navItem is one entry in the site navigation.
type navItem struct {
	Label string
	Href  string
}

var navItems = []navItem{
	{Label: "About Me", Href: "index.html#about"},
	{Label: "Insurance", Href: "index.html#insurance"},
	{Label: "Contact", Href: "index.html#contact"},
}

// ariaCurrent returns "page" when href is the page being rendered.
func ariaCurrent(href string, canonicalPath string) string {
	if href == canonicalPath {
		return "page"
	}
	return "false"
}

// Page renders the shell: semantic HTML, editorial header, SEO meta, and footer.
// canonicalPath: "index.html" for the homepage, or "about_me.html", "contact.html" etc.
// noindex: true for thank_you, 404, and other non-indexable pages.
templ Page(title string, description string, canonicalPath string, noindex bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="theme-color" content="#e4eef2"/>
			<title>{ title }</title>
			<meta name="description" content={ description }/>
			if noindex {
				<meta name="robots" content="noindex, follow"/>
			}
			<link rel="canonical" href={ "https://www.mychicagotherapy.com/" + canonicalPath }/>
			<!-- Open Graph -->
			<meta property="og:type" content="website"/>
			<meta property="og:title" content={ title }/>
			<meta property="og:description" content={ description }/>
			<meta property="og:url" content={ "https://www.mychicagotherapy.com/" + canonicalPath }/>
			<meta property="og:image" content="https://www.mychicagotherapy.com/images/jeremy.png"/>
			<meta property="og:image:alt" content="Jeremy Dales, Clinical Social Worker at My Chicago Therapy"/>
			<meta property="og:image:width" content="500"/>
			<meta property="og:image:height" content="500"/>
			<meta property="og:locale" content="en_US"/>
			<meta property="og:site_name" content="My Chicago Therapy"/>
			<!-- Twitter Card -->
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ title }/>
			<meta name="twitter:description" content={ description }/>
			<meta name="twitter:image" content="https://www.mychicagotherapy.com/images/jeremy.png"/>
			<meta name="twitter:image:alt" content="Jeremy Dales, Clinical Social Worker at My Chicago Therapy"/>
			<link rel="icon" href="images/favicon.png" type="image/png" sizes="32x32"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="preconnect" href="https://www.googletagmanager.com"/>
			<link rel="stylesheet" href="./src/tailwind.css"/>
			if canonicalPath == "index.html" {
				<link rel="preload" as="image" href="images/background-mobile.webp" media="(max-width: 47.99rem)" fetchpriority="high"/>
				<link rel="preload" as="image" href="images/background.webp" media="(min-width: 48rem)" fetchpriority="high"/>
			}
			<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=Oswald:wght@500&display=swap"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=Oswald:wght@500&display=swap" media="print" onload="this.media='all'"/>
			<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=Oswald:wght@500&display=swap"/></noscript>
			<!-- Google tag (gtag.js), loaded after the page has finished rendering -->
			<script>
				window.dataLayer = window.dataLayer || [];
				function gtag(){dataLayer.push(arguments);}
				gtag('js', new Date());
				gtag('config', 'AW-17617137190');
				window.addEventListener('load', function () {
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtag/js?id=AW-17617137190';
					document.head.appendChild(s);
				});
			</script>
			<script type="application/ld+json">
				{
					"@context": "https://schema.org",
					"@type": "ProfessionalService",
					"name": "My Chicago Therapy",
					"description": "Professional therapy in Chicago. Individual therapy for adults with a person-centered approach.",
					"url": "https://www.mychicagotherapy.com",
					"image": "https://www.mychicagotherapy.com/images/jeremy.png",
					"email": "jeremy@mychicagotherapy.com",
					"address": { "@type": "PostalAddress", "addressLocality": "Chicago", "addressRegion": "IL", "addressCountry": "US" },
					"areaServed": { "@type": "Place", "name": "Chicago, IL" },
					"founder": { "@type": "Person", "name": "Jeremy Dales", "jobTitle": "Licensed Clinical Social Worker" },
					"knowsAbout": ["Individual therapy", "Cognitive behavioral therapy", "Dialectical behavior therapy", "Anxiety", "Depression", "Grief", "Life transitions"]
				}
			</script>
		</head>
		<body>
			<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-[60] focus:p-4 focus:bg-navy focus:text-white">Skip to main content</a>
			<header
				id="top"
				class={ "site-header", templ.KV("site-header--overlay", canonicalPath == "index.html") }
			>
				<div class="wrap site-header__inner">
					<a class="brand" href="index.html">
						<img class="brand__mark" src="images/logo.png" alt="" width="64" height="64" loading="eager" decoding="async"/>
						<span>
							<span class="brand__name">My Chicago Therapy</span>
							<span class="brand__tag">Jeremy Dales, LCSW</span>
						</span>
					</a>
					<nav class="nav" aria-label="Main navigation">
						for _, item := range navItems {
							<a href={ templ.SafeURL(item.Href) } aria-current={ ariaCurrent(item.Href, canonicalPath) }>{ item.Label }</a>
						}
						<a class="nav__cta" href="index.html#contact">Book a consultation</a>
					</nav>
					<button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
						<span></span>
						<span></span>
					</button>
				</div>
			</header>
			<div id="mobile-menu" class="menu-overlay" data-open="false" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Site menu">
				<div class="menu-overlay__top">
					<a class="brand" href="index.html">
						<img class="brand__mark" src="images/logo.png" alt="" width="64" height="64" loading="lazy" decoding="async"/>
						<span>
							<span class="brand__name">My Chicago Therapy</span>
							<span class="brand__tag">Jeremy Dales, LCSW</span>
						</span>
					</a>
					<button class="menu-overlay__close" type="button" aria-label="Close menu"></button>
				</div>
				<ul class="menu-overlay__links">
					<li><a href="index.html" aria-current={ ariaCurrent("index.html", canonicalPath) }>Home</a></li>
					for _, item := range navItems {
						<li><a href={ templ.SafeURL(item.Href) } aria-current={ ariaCurrent(item.Href, canonicalPath) }>{ item.Label }</a></li>
					}
				</ul>
				<div class="menu-overlay__footer">
					<a class="btn w-full" href="index.html#contact">Book a consultation</a>
				</div>
			</div>
			<main id="main-content">
				{ children... }
			</main>
			<footer class="site-footer">
				<div class="wrap">
					<p class="site-footer__name">My Chicago Therapy</p>
					<div class="site-footer__lines">
						<p>Jeremy Dales, LCSW</p>
						<p><a href="mailto:jeremy@mychicagotherapy.com">jeremy@mychicagotherapy.com</a></p>
						<p>Chicago, Illinois</p>
					</div>
					<nav class="site-footer__nav" aria-label="Footer navigation">
						<a href="index.html">Home</a>
						for _, item := range navItems {
							<a href={ templ.SafeURL(item.Href) }>{ item.Label }</a>
						}
					</nav>
					<p class="site-footer__legal">© { time.Now().Format("2006") } My Chicago Therapy</p>
				</div>
			</footer>
			<a href="#top" class="to-top" aria-label="Back to top" data-visible="false">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
			</a>
			<script src="./src/a11y.js"></script>
		</body>
	</html>
}

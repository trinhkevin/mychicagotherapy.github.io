package main

templ ThankYou() {
	@Page("Thank You | My Chicago Therapy", "Thank you for reaching out. We will respond within 48–72 business hours.", "thank_you.html", true) {
		<section class="band section--tight text-center" aria-labelledby="thanks-title">
			<div class="wrap">
				<h1 id="thanks-title" class="title">Thank you</h1>
			</div>
		</section>
		<section class="section text-center">
			<div class="wrap max-w-2xl">
				<p class="statement">Your message is on its way.</p>
				<p class="lede muted mt-6">I will respond within 48–72 business hours. In the meantime, feel free to read more about <a class="inline-link" href="index.html#about">my approach</a>.</p>
				<div class="mt-10">
					<a class="btn" href="index.html">Back to home</a>
				</div>
			</div>
		</section>
	}
}

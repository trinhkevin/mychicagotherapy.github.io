package main

templ NotFound() {
	@Page("Page Not Found | My Chicago Therapy", "The page you are looking for could not be found.", "404.html", true) {
		<section class="band section--tight text-center" aria-labelledby="nf-title">
			<div class="wrap">
				<h1 id="nf-title" class="title">Page not found</h1>
			</div>
		</section>
		<section class="section text-center">
			<div class="wrap max-w-2xl">
				<p class="lede muted">The page you're looking for isn't here, but you're welcome to start from the beginning.</p>
				<div class="mt-10">
					<a class="btn" href="index.html">Return home</a>
				</div>
			</div>
		</section>
	}
}
